# Server Configuration
PORT=3000

# QUMS ERP Configuration (Keep secret - never expose in frontend)
QUMS_BASE_URL=https://qums.quantumuniversity.edu.in
QUMS_REG_ID=your_registration_id_here
QUMS_YEAR_SEM=5

# Authenticated session cookie obtained from your browser after logging into QUMS
# Example: ASP.NET_SessionId=xxxxxxxxxxxxxxxxxxxxxxxx
QUMS_SESSION_COOKIE=

# Optional: Only if your QUMS browser request includes __RequestVerificationToken
QUMS_CSRF_TOKEN=
